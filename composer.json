{
    "name": "mantas6/zero",
    "description": "A CLI tool for managing Toggl time tracking from the terminal.",
    "keywords": ["toggl", "time-tracking", "cli", "console", "laravel-zero"],
    "homepage": "https://github.com/mantas6/zero",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mantas6/zero/issues",
        "source": "https://github.com/mantas6/zero"
    },
    "require": {
        "php": "^8.2.0",
        "illuminate/database": "^11.5",
        "laravel-zero/framework": "^11.0.2",
        "laravel/boost": "^2.2",
        "laravel/serializable-closure": "^2.0",
        "saloonphp/laravel-http-sender": "^3.0",
        "saloonphp/laravel-plugin": "^3.0",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.18.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.5.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["zero"]
}
